PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/midas_eduventures?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Production & CORS URLs
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com
SERVER_URL=https://your-backend-domain.com
PRODUCTION_URL=https://your-frontend-domain.com

# Nodemailer Email Configuration
PRINCIPAL_EMAIL=principal@school.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
